# ─────────────────────────────────────────────────────────────────────────────
# AI Interpreter Workbench — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. It is listed in .gitignore.
#
# API keys are BACKEND ONLY — they are never sent to or stored in the browser.
# ─────────────────────────────────────────────────────────────────────────────


# ── API Keys ──────────────────────────────────────────────────────────────────
# ALL keys are optional. With none set, the app boots in mock/offline mode and
# the cascade runs end-to-end with deterministic mock providers. Realtime mode
# specifically requires OPENAI_API_KEY.

# OpenAI — Realtime mode (gpt-realtime), cascade STT (gpt-4o-transcribe), and TTS.
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Anthropic — default Claude translation provider in cascade mode.
# Get yours at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Deepgram — OPTIONAL. A swappable production STT provider for cascade mode.
# If unset, cascade STT uses OpenAI's transcription session. ($200 free credit.)
# https://console.deepgram.com
DEEPGRAM_API_KEY=...


# ── Provider Selection (cascade mode) ─────────────────────────────────────────
# The first available provider in each chain is used; all chains fall back to a
# mock provider so a session never hard-fails.

# STT: openai (default, needs OPENAI_API_KEY) | deepgram (needs DEEPGRAM_API_KEY) | mock
STT_PROVIDER=openai
# Translation: claude (default) | openai | mock
TRANSLATION_PROVIDER=claude
# TTS: openai (default) | mock
TTS_PROVIDER=openai


# ── Eval-Only API Keys ────────────────────────────────────────────────────────
# Use SEPARATE keys from development to isolate eval billing.
# Only required when running: pnpm eval:run

EVAL_API_KEY_OPENAI=sk-...
EVAL_API_KEY_ANTHROPIC=sk-ant-...
EVAL_API_KEY_DEEPGRAM=...


# ── Model Configuration ───────────────────────────────────────────────────────

# OpenAI Realtime model (the brief requires gpt-realtime)
OPENAI_REALTIME_MODEL=gpt-realtime

# OpenAI streaming STT model for cascade mode
# Options: gpt-4o-transcribe, gpt-4o-mini-transcribe
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# OpenAI TTS model
# Options: tts-1 (faster, lower quality), tts-1-hd (slower, higher quality)
OPENAI_TTS_MODEL=tts-1

# Anthropic Claude model for translation
# Options: claude-haiku-4-5 (recommended: fastest), claude-sonnet-4-6 (higher quality)
CLAUDE_MODEL=claude-haiku-4-5

# Deepgram STT model
# Options: nova-2 (recommended), nova-2-medical, whisper-large
DEEPGRAM_MODEL=nova-2


# ── Latency Thresholds ────────────────────────────────────────────────────────
# Used for UI colour coding (green/amber/red) and CI benchmark gates.
# Values in milliseconds.

LATENCY_THRESHOLD_REALTIME_MS=1500
LATENCY_THRESHOLD_CASCADE_MS=3000

# Per-stage thresholds for cascade dashboard colour coding
LATENCY_THRESHOLD_STT_FIRST_WORD_MS=400
LATENCY_THRESHOLD_TRANSLATION_FIRST_TOKEN_MS=300
LATENCY_THRESHOLD_TTS_FIRST_CHUNK_MS=300


# ── Server Configuration ──────────────────────────────────────────────────────

PORT=3001
HOST=0.0.0.0

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Structured log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# HTTP rate limiting (requests per IP per minute)
RATE_LIMIT_PER_MINUTE=60


# ── Circuit Breaker Configuration ─────────────────────────────────────────────
# Set CIRCUIT_BREAKER_ENABLED=false in local dev to disable (avoids false trips
# when testing error scenarios manually).

CIRCUIT_BREAKER_ENABLED=true

# Number of errors within the window before opening a breaker
CIRCUIT_BREAKER_ERROR_THRESHOLD=5

# Rolling window size in seconds
CIRCUIT_BREAKER_WINDOW_SECONDS=60

# How long to keep the breaker open before allowing a probe (seconds)
CIRCUIT_BREAKER_OPEN_DURATION_SECONDS=30


# ── Session & Audio Configuration ────────────────────────────────────────────

# Maximum concurrent WebSocket sessions (per process)
MAX_SESSIONS=50

# Audio chunk size sent to backend (milliseconds)
AUDIO_CHUNK_MS=100

# PCM sample rate (Hz) — must match what Deepgram and OpenAI Realtime expect
AUDIO_SAMPLE_RATE=16000

# TTS playback jitter buffer (number of chunks)
TTS_JITTER_BUFFER_CHUNKS=3

# Maximum TTS queue depth before backpressure kicks in
TTS_MAX_QUEUE_SIZE=5


# ── Eval Configuration ────────────────────────────────────────────────────────

# Set to true to write eval results to eval-results/ directory
EVAL_STORE_ENABLED=false

# Directory for eval results (relative to repo root)
EVAL_RESULTS_DIR=eval-results

# BLEU score below which the eval runner exits 1 (CI gate)
EVAL_BLEU_FAIL_THRESHOLD=0.60

# WER above which the eval runner exits 1 (CI gate)
EVAL_WER_FAIL_THRESHOLD=0.20


# ── Feature Flags ─────────────────────────────────────────────────────────────

# Set to true to record provider responses as fixtures (for test fixture updates)
# WARNING: This writes real API responses to golden-data/fixtures/ — review before committing.
RECORD_FIXTURES=false

# Enable admin endpoints (POST /admin/circuit-breaker/:provider/open|close)
# Should be false in production unless behind auth middleware
ADMIN_ENDPOINTS_ENABLED=true
